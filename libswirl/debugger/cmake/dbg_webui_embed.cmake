# Build-time half of the devtools UI embed (dbg_webui.cmake is the configure-time half).
#
#   cmake -DDIST=<bundle directory, or empty> -DOUT=<dbg_webui_data.cpp> -DPROTOCOL=<n> -P dbg_webui_embed.cmake
#
# Writes OUT: every file below DIST as a gzip stream in a brace-initialised unsigned char array (string
# literals and .incbin are not portable to MSVC), and the table dbg_webui.cpp looks files up in. The
# directory is listed here, at build time, because the bundler names its assets by content hash. Hidden
# names (a leading '.', files and directories) are left out: the server answers no path that has one. An
# empty DIST gives the empty table.

cmake_minimum_required(VERSION 3.10)

set(version "")
set(git_rev "")
set(table "")
set(tmp "${OUT}.tmp")
set(gz "${OUT}.gz")

file(WRITE "${tmp}" "// Generated by debugger/cmake/dbg_webui_embed.cmake, do not edit.

#include \"debugger/dbg_webui.h\"

namespace dbg { namespace webui {

")

if(NOT DIST STREQUAL "")
  # string(JSON) and file(ARCHIVE_CREATE ... COMPRESSION_LEVEL); the empty table needs neither.
  if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "nullDC devtools UI: embedding needs CMake 3.19 or newer, this is ${CMAKE_VERSION}")
  endif()
  file(READ "${DIST}/bundle-info.json" info)
  string(JSON version GET "${info}" version)
  string(JSON bundle_protocol GET "${info}" protocol)
  string(JSON git_rev ERROR_VARIABLE error GET "${info}" gitRev)
  if(NOT error STREQUAL "NOTFOUND")
    set(git_rev "")
  endif()
  if(NOT "${bundle_protocol}" STREQUAL "${PROTOCOL}")
    message(FATAL_ERROR "nullDC devtools UI: ${DIST} is built for protocol ${bundle_protocol}, the debugger speaks protocol ${PROTOCOL}")
  endif()
  foreach(text IN ITEMS "${version}" "${git_rev}")
    if(NOT text MATCHES "^[A-Za-z0-9_.+~:/ -]*$")
      message(FATAL_ERROR "nullDC devtools UI: ${DIST}/bundle-info.json: '${text}' cannot be embedded as a string")
    endif()
  endforeach()

  # A bundle whose files do not match its own manifest is a half-written or mixed-up build.
  string(JSON count ERROR_VARIABLE error LENGTH "${info}" files)
  if(error STREQUAL "NOTFOUND" AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON path ERROR_VARIABLE error1 GET "${info}" files ${i} path)
      string(JSON expected ERROR_VARIABLE error2 GET "${info}" files ${i} sha256)
      if(error1 STREQUAL "NOTFOUND" AND error2 STREQUAL "NOTFOUND")
        if(NOT EXISTS "${DIST}/${path}")
          message(FATAL_ERROR "nullDC devtools UI: ${DIST}/${path} is listed in bundle-info.json but missing; rebuild the UI")
        endif()
        file(SHA256 "${DIST}/${path}" actual)
        string(TOLOWER "${expected}" expected)
        if(NOT actual STREQUAL expected)
          message(FATAL_ERROR "nullDC devtools UI: ${DIST}/${path} does not match its sha256 in bundle-info.json; rebuild the UI")
        endif()
      endif()
    endforeach()
  endif()

  # The listing separates the names with ';' and leaves one inside a name as it is, so such a name would
  # arrive in pieces. A file name with one is refused here, a hidden file's as well.
  file(GLOB_RECURSE cut RELATIVE "${DIST}" "${DIST}/*;*")
  if(NOT cut STREQUAL "")
    message(FATAL_ERROR "nullDC devtools UI: ${DIST}/${cut}: this file name cannot be embedded")
  endif()

  file(GLOB_RECURSE files RELATIVE "${DIST}" "${DIST}/*")
  list(SORT files)
  set(index 0)
  foreach(path IN LISTS files)
    if(path MATCHES "(^|/)[.]")
      continue()
    endif()
    # Names go into a C string and a CMake list as they are. A ';' in a directory name is not seen above:
    # the paths below it arrive cut, and a piece that is no file ends here, under the name of the piece.
    # Pieces that exist get past this: one that is a directory stops at file(SIZE), ones that are files are
    # embedded in place of the file that was meant.
    if(NOT path MATCHES "^[-A-Za-z0-9 !#%&'()+,./=@^_{}~]+$" OR NOT EXISTS "${DIST}/${path}")
      message(FATAL_ERROR "nullDC devtools UI: ${DIST}/${path}: this file name cannot be embedded")
    endif()
    file(SIZE "${DIST}/${path}" raw_size)
    file(ARCHIVE_CREATE OUTPUT "${gz}" PATHS "${DIST}/${path}" FORMAT raw COMPRESSION GZip COMPRESSION_LEVEL 9)
    file(READ "${gz}" hex HEX)

    # Bytes 4..7 of a gzip header are a timestamp; cleared, the output depends on the content only.
    string(SUBSTRING "${hex}" 0 8 head)
    string(SUBSTRING "${hex}" 16 -1 hex)
    if(NOT head STREQUAL "1f8b0800")
      message(FATAL_ERROR "nullDC devtools UI: unexpected gzip header ${head} for ${DIST}/${path}")
    endif()
    set(hex "${head}00000000${hex}")

    # Eight bytes per line: one regex pass handles them, the remainder gets its own.
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    math(EXPR rows_length "${hex_length} / 16 * 16")
    string(SUBSTRING "${hex}" 0 ${rows_length} rows)
    string(SUBSTRING "${hex}" ${rows_length} -1 rest)
    string(REGEX REPLACE "(..)(..)(..)(..)(..)(..)(..)(..)" "0x\\1,0x\\2,0x\\3,0x\\4,0x\\5,0x\\6,0x\\7,0x\\8,\n" rows "${rows}")
    string(REGEX REPLACE "(..)" "0x\\1," rest "${rest}")

    file(APPEND "${tmp}" "// ${path}: ${raw_size} bytes, ${size} stored\nstatic const unsigned char file${index}[] = {\n${rows}${rest}\n};\n\n")
    string(APPEND table "\t{ \"${path}\", file${index}, sizeof(file${index}), ${raw_size} },\n")
    math(EXPR index "${index} + 1")
  endforeach()
  file(REMOVE "${gz}")
endif()

file(APPEND "${tmp}" "const File kFiles[] = {
${table}\t{ nullptr, nullptr, 0, 0 }
};

const char kVersion[] = \"${version}\";
const char kGitRev[] = \"${git_rev}\";

} }
")
file(RENAME "${tmp}" "${OUT}")
