# The cases of tests/windows (CMakeLists.txt of this directory has the list), as a script:
#
#   cmake -DCASE=<case> -DWINRUN=<nulldc3-winrun.exe> -DEMULATOR=<nulldc3.exe> -DGUEST=<dsptest.elf>
#         -DWORK=<scratch directory> -P windows.cmake
#
# Every program is started through nulldc3-winrun, and every emulator run carries P0's keys (a portable directory
# under WORK, config:Headless=yes, audio:backend=none, config:Dreamcast.RTC=946684800); the help box cases leave
# config:Headless out on purpose, with a command line that is refused before anything runs. nulldc3-winrun's last
# line on stderr says what it saw on its desktop and the verdict; a case fails on a window it did not want, on a
# timeout of nulldc3-winrun (124) and on a failed set-up (126).

cmake_minimum_required(VERSION 3.16)

if(NOT CASE OR NOT WINRUN OR NOT WORK)
  message(FATAL_ERROR "windows.cmake: needs -DCASE= -DWINRUN= -DWORK=")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

set(problems "")
macro(problem text)
  list(APPEND problems "${text}")
endmacro()

# run(<name> [OWN] [TIMEOUT <s>] [ENV <name=value>...] [FILES] -- <program> <argument>...): <name>_rc, <name>_out,
# <name>_err, <name>_seconds; with FILES the output goes to <WORK>/<name>.out and .err and is read back from there
function(run name)
  cmake_parse_arguments(ARG "OWN;FILES;NUL" "TIMEOUT" "ENV;COMMAND" ${ARGN})
  if(NOT ARG_TIMEOUT)
    set(ARG_TIMEOUT 90)
  endif()
  set(own "")
  if(ARG_OWN)
    set(own --own-console)
  endif()
  foreach(e ${ARG_ENV})
    string(REGEX MATCH "^([^=]+)=(.*)$" _ "${e}")
    set(ENV{${CMAKE_MATCH_1}} "${CMAKE_MATCH_2}")
  endforeach()
  math(EXPR outer "${ARG_TIMEOUT} + 60")
  string(TIMESTAMP t0 "%s")
  if(ARG_NUL)
    execute_process(COMMAND "${WINRUN}" ${own} --timeout ${ARG_TIMEOUT} -- ${ARG_COMMAND}
                    WORKING_DIRECTORY "${WORK}" TIMEOUT ${outer} RESULT_VARIABLE rc OUTPUT_FILE NUL ERROR_FILE NUL)
    set(out "")
    set(err "")
  elseif(ARG_FILES)
    execute_process(COMMAND "${WINRUN}" ${own} --timeout ${ARG_TIMEOUT} -- ${ARG_COMMAND}
                    WORKING_DIRECTORY "${WORK}" TIMEOUT ${outer} RESULT_VARIABLE rc
                    OUTPUT_FILE "${WORK}/${name}.out" ERROR_FILE "${WORK}/${name}.err")
    file(READ "${WORK}/${name}.out" out)
    file(READ "${WORK}/${name}.err" err)
  else()
    execute_process(COMMAND "${WINRUN}" ${own} --timeout ${ARG_TIMEOUT} -- ${ARG_COMMAND}
                    WORKING_DIRECTORY "${WORK}" TIMEOUT ${outer} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  endif()
  string(TIMESTAMP t1 "%s")
  foreach(e ${ARG_ENV})
    string(REGEX MATCH "^([^=]+)=" _ "${e}")
    unset(ENV{${CMAKE_MATCH_1}})
  endforeach()
  math(EXPR seconds "${t1} - ${t0}")
  file(WRITE "${WORK}/${name}.log" "exit ${rc} after ${seconds} s\n--- stdout\n${out}\n--- stderr\n${err}\n")
  message("${name}: exit ${rc} after ${seconds} s")
  set(${name}_rc "${rc}" PARENT_SCOPE)
  set(${name}_out "${out}" PARENT_SCOPE)
  set(${name}_err "${err}" PARENT_SCOPE)
  set(${name}_seconds "${seconds}" PARENT_SCOPE)
endfunction()

# What nulldc3-winrun saw: <name>_windows, <name>_visible, <name>_emuclass, <name>_child (the program's own exit
# status), <name>_timeout (1 or 0), <name>_verdict
macro(winrun_summary name)
  if("${${name}_err}" MATCHES "winrun: desktop [^\n]*: ([0-9]+) window\\(s\\) seen, ([0-9]+) visible, ([0-9]+) of the emulator's class; the program's exit status ([0-9]+)( \\(timeout\\))?; winrun exits with ([0-9]+)")
    set(${name}_windows "${CMAKE_MATCH_1}")
    set(${name}_visible "${CMAKE_MATCH_2}")
    set(${name}_emuclass "${CMAKE_MATCH_3}")
    set(${name}_child "${CMAKE_MATCH_4}")
    if(CMAKE_MATCH_5)
      set(${name}_timeout 1)
    else()
      set(${name}_timeout 0)
    endif()
    set(${name}_verdict "${CMAKE_MATCH_6}")
  else()
    problem("${name}: nulldc3-winrun's summary line is missing")
    set(${name}_visible -1)
    set(${name}_emuclass -1)
    set(${name}_timeout -1)
    set(${name}_verdict -1)
  endif()
endmacro()

# No window, no timeout, no failed set-up
macro(no_window name)
  winrun_summary(${name})
  if(NOT "${${name}_visible}" STREQUAL "0" OR NOT "${${name}_emuclass}" STREQUAL "0")
    problem("${name}: nulldc3-winrun saw ${${name}_visible} visible window(s) and ${${name}_emuclass} of the emulator's class")
  endif()
  if(NOT "${${name}_timeout}" STREQUAL "0")
    problem("${name}: nulldc3-winrun's timeout ended the run")
  endif()
  if("${${name}_rc}" STREQUAL "124" OR "${${name}_rc}" STREQUAL "125" OR "${${name}_rc}" STREQUAL "126")
    problem("${name}: nulldc3-winrun exits with ${${name}_rc}")
  endif()
endmacro()

set(keys --portable "${WORK}/portable" --config config:Headless=yes , audio:backend=none , config:Dreamcast.RTC=946684800)
file(MAKE_DIRECTORY "${WORK}/portable")
set(guest_run , config:Exit.AfterVblanks=90 , config:Exit.StateHash=yes , config:Dynarec.Enabled=yes "${GUEST}")

# The crash-report places: names only
function(crash_places out)
  set(all "")
  foreach(dir "$ENV{LOCALAPPDATA}/CrashDumps" "$ENV{LOCALAPPDATA}/Microsoft/Windows/WER/ReportQueue"
              "$ENV{LOCALAPPDATA}/Microsoft/Windows/WER/ReportArchive" "$ENV{ProgramData}/Microsoft/Windows/WER/ReportQueue"
              "$ENV{ProgramData}/Microsoft/Windows/WER/ReportArchive")
    file(GLOB entries LIST_DIRECTORIES true "${dir}/*")
    list(APPEND all ${entries})
  endforeach()
  set(${out} "${all}" PARENT_SCOPE)
endfunction()

set(fault_re "fault_handler: unhandled ([A-Z]+) at address 0x[0-9a-f]+, pc 0x[0-9a-f]+, not a guest memory fault: terminating")

if(CASE STREQUAL "probe")
  run(probe TIMEOUT 10 COMMAND "${WINRUN}" --probe)
  winrun_summary(probe)
  if(NOT probe_rc EQUAL 125)
    problem("the probe's run exits with ${probe_rc}, not 125")
  endif()
  if(NOT probe_out MATCHES "winrun probe: desktop (winrun-[0-9]+)\n")
    problem("the probe did not say the name of a desktop winrun-<n>")
  else()
    set(desktop "${CMAKE_MATCH_1}")
    if(NOT probe_err MATCHES "winrun: desktop [^\n]*\\\\${desktop}: ")
      problem("nulldc3-winrun's desktop is not the probe's (${desktop})")
    endif()
  endif()
  if(NOT probe_err MATCHES "winrun: window class=nulldc3-winrun-probe visible=1 pid=[0-9]+ image=nulldc3-winrun.exe")
    problem("nulldc3-winrun's list does not have the probe's visible window")
  endif()

elseif(CASE STREQUAL "headless")
  run(headless ENV NULLDC_TEST_UI_REPORT=1 COMMAND "${EMULATOR}" ${keys} ${guest_run})
  no_window(headless)
  if(NOT headless_rc EQUAL 0)
    problem("exit ${headless_rc}, not 0")
  endif()
  if(NOT headless_out MATCHES "\nnulldc-exit: reason=vblanks ")
    problem("no exit line")
  endif()
  if(NOT headless_out MATCHES "nulldc-ui: app=([0-9]) windows=([0-9]+) errmode=([0-9a-f]+) wer=([0-9a-f]+) invparam=([0-9]) purecall=([0-9]) sigabrt=([0-9]) abort=([0-9a-f]+) classes=([^\n]*)")
    problem("no nulldc-ui line")
  else()
    set(app "${CMAKE_MATCH_1}")
    set(windows "${CMAKE_MATCH_2}")
    set(errmode "${CMAKE_MATCH_3}")
    set(wer "${CMAKE_MATCH_4}")
    set(invparam "${CMAKE_MATCH_5}")
    set(purecall "${CMAKE_MATCH_6}")
    set(sigabrt "${CMAKE_MATCH_7}")
    set(abort "${CMAKE_MATCH_8}")
    set(classes "${CMAKE_MATCH_9}")
    message("nulldc-ui: app=${app} windows=${windows} errmode=${errmode} wer=${wer} invparam=${invparam} purecall=${purecall} sigabrt=${sigabrt} abort=${abort} classes=${classes}")
    if(NOT app EQUAL 0)
      problem("app=${app}: a window class was registered")
    endif()
    if(NOT windows EQUAL 0)
      problem("windows=${windows}")
    endif()
    if(classes MATCHES "OleMainThreadWndClass")
      problem("classes has OleMainThreadWndClass: a COM apartment in a headless run")
    endif()
    math(EXPR wer_no_ui "0x${wer} & 0x20")	# WER_FAULT_REPORTING_NO_UI
    if(NOT wer_no_ui)
      problem("wer=${wer}: no WER_FAULT_REPORTING_NO_UI")
    endif()
    foreach(handler invparam purecall sigabrt)
      if(NOT ${handler} EQUAL 1)
        problem("${handler}=${${handler}}: the handler in force is not the policy's")
      endif()
    endforeach()
    math(EXPR abort_set "0x${abort} & 0x3")	# _WRITE_ABORT_MSG | _CALL_REPORTFAULT
    if(abort_set)
      problem("abort=${abort}: _WRITE_ABORT_MSG or _CALL_REPORTFAULT is set")
    endif()
  endif()

elseif(CASE MATCHES "^fatal\\.(.+)$")
  set(kind "${CMAKE_MATCH_1}")
  set(sig_segv SIGSEGV)
  set(sig_ill SIGILL)
  set(sig_abort SIGABRT)
  set(sig_div SIGFPE)
  set(sig_stack SIGSEGV)
  set(sig_invparam SIGABRT)
  set(sig_purecall SIGABRT)
  set(code_SIGSEGV 139)
  set(code_SIGILL 132)
  set(code_SIGTRAP 133)
  set(code_SIGABRT 134)
  set(code_SIGFPE 136)
  if(kind STREQUAL "trap")
    set(want 133)
  else()
    set(sig "${sig_${kind}}")
    if(NOT sig)
      message(FATAL_ERROR "windows.cmake: no fatal kind ${kind}")
    endif()
    set(want ${code_${sig}})
  endif()

  crash_places(before)
  run(fatal ENV NULLDC_TEST_FATAL=${kind} TIMEOUT 60 COMMAND "${EMULATOR}" ${keys} ${guest_run})
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2)
  crash_places(after)

  no_window(fatal)
  if(NOT fatal_rc EQUAL want)
    problem("exit ${fatal_rc}, not ${want}")
  endif()
  if(kind STREQUAL "trap")
    if(NOT fatal_out MATCHES "Fatal error : NULLDC_TEST_FATAL")
      problem("no \"Fatal error : NULLDC_TEST_FATAL\" on stdout")
    endif()
    if(fatal_out MATCHES "fault_handler" OR fatal_err MATCHES "fault_handler")
      problem("a fault_handler line after die()")
    endif()
  else()
    if(NOT fatal_err MATCHES "${fault_re}")
      problem("no fault_handler line on stderr")
    elseif(NOT CMAKE_MATCH_1 STREQUAL sig)
      problem("the fault_handler line says ${CMAKE_MATCH_1}, not ${sig}")
    endif()
  endif()
  set(new "")
  foreach(entry ${after})
    if(NOT entry IN_LIST before)
      get_filename_component(entry_name "${entry}" NAME)
      list(APPEND new "${entry_name}")
    endif()
  endforeach()
  if(new)
    problem("new in the crash-report places: ${new}")
  endif()

elseif(CASE STREQUAL "helpbox")
  # Not headless, and refused before anything runs: --bogus
  set(nohead --portable "${WORK}/portable" --config audio:backend=none , config:Dreamcast.RTC=946684800 --bogus)

  # (1) the output is kept, in a pipe, then in NUL: no box
  run(pipe TIMEOUT 30 COMMAND "${EMULATOR}" ${nohead})
  no_window(pipe)
  if(NOT pipe_rc EQUAL 2)
    problem("pipe: exit ${pipe_rc}, not 2")
  endif()
  if(NOT pipe_err MATCHES "unknown switch --bogus")
    problem("pipe: the reason is not on stderr")
  endif()
  run(nul TIMEOUT 30 NUL COMMAND "${EMULATOR}" ${nohead})
  if(NOT nul_rc EQUAL 2)
    problem("NUL: exit ${nul_rc}, not 2 (125: a window)")
  endif()

  # (2) a console of its own, headless: no box, and at once
  run(owncon_headless OWN TIMEOUT 10 COMMAND "${EMULATOR}" ${keys} --bogus)
  no_window(owncon_headless)
  if(NOT owncon_headless_rc EQUAL 2)
    problem("own console, headless: exit ${owncon_headless_rc}, not 2")
  endif()
  if(owncon_headless_seconds GREATER 9)
    problem("own console, headless: ${owncon_headless_seconds} s")
  endif()

  # (3) a console of its own, not headless: the box, on the private desktop, until the timeout ends it
  run(owncon_box OWN TIMEOUT 10 COMMAND "${EMULATOR}" ${nohead})
  winrun_summary(owncon_box)
  if(NOT owncon_box_rc EQUAL 125)
    problem("own console, not headless: nulldc3-winrun exits with ${owncon_box_rc}, not 125 (the box)")
  endif()
  if(NOT owncon_box_err MATCHES "winrun: window class=#32770 visible=1 pid=[0-9]+ image=nulldc3.exe")
    problem("own console, not headless: no visible message box (#32770) of nulldc3.exe in nulldc3-winrun's list")
  endif()

elseif(CASE STREQUAL "binary_stdout")
  # stdout: --help and the guest's run with its exit line; stderr: a refused command line, whose reason is the
  # emulator's line there (cfg/cl.cpp). nulldc3-winrun's own lines on stderr end in \n alone.
  run(help FILES COMMAND "${EMULATOR}" ${keys} --help)
  run(guest FILES COMMAND "${EMULATOR}" ${keys} ${guest_run})
  run(refused FILES COMMAND "${EMULATOR}" ${keys} --bogus)
  set(want_help 0)
  set(want_guest 0)
  set(want_refused 2)
  foreach(name help guest refused)
    no_window(${name})
    if(NOT ${name}_rc EQUAL want_${name})
      problem("${name}: exit ${${name}_rc}, not ${want_${name}}")
    endif()
  endforeach()
  if(NOT refused_err MATCHES "unknown switch --bogus")
    problem("refused: the reason is not on stderr")
  endif()
  foreach(look help.out guest.out refused.err)
    file(READ "${WORK}/${look}" bytes HEX)
    string(LENGTH "${bytes}" length)
    math(EXPR length "${length} / 2")
    if(NOT bytes MATCHES "^([0-9a-f][0-9a-f])*0a")
      problem("${look}: no line to look at")
    endif()
    if(bytes MATCHES "^([0-9a-f][0-9a-f])*0d")
      problem("${look}: a \\\\r in it (text mode)")
    endif()
    message("${look}: ${length} bytes")
  endforeach()

elseif(CASE STREQUAL "dsound_failed")
  # DirectSound that cannot start (NULLDC_TEST_DSOUND=fail: DirectSoundCreate8 answers DSERR_NODRIVER and is not
  # called, so nothing sounds) is no sound, and with the speed limit on (aica.LimitFPS, the default) the run waits
  # for no sound device: the samples take the push path, which takes nothing, and the guest reaches its 90 vblanks
  # and its exit line. The keys are P0's but for audio:backend.
  set(dskeys --portable "${WORK}/portable" --config config:Headless=yes , audio:backend=directsound ,
             config:Dreamcast.RTC=946684800 , config:aica.LimitFPS=yes)
  run(dsound ENV NULLDC_TEST_DSOUND=fail TIMEOUT 60 COMMAND "${EMULATOR}" ${dskeys} ${guest_run})
  no_window(dsound)
  if(NOT dsound_rc EQUAL 0)
    problem("exit ${dsound_rc}, not 0 (124: the run hung)")
  endif()
  if(NOT dsound_out MATCHES "DirectSound: DirectSoundCreate8 failed \\(0x88780078\\): no sound")
    problem("no line of the failed DirectSound on stdout")
  endif()
  if(NOT dsound_out MATCHES "\nnulldc-exit: reason=vblanks ")
    problem("no exit line")
  endif()

elseif(CASE STREQUAL "detach")
  # --detach returns at once with the copy's pid, though its caller reads its output through a pipe (here CMake's,
  # as WSL's interop or Python's subprocess would), and the copy runs the program to its end and writes the rc file
  set(log "${WORK}/detach-copy.log")
  set(rc_file "${WORK}/detach.rc")
  string(TIMESTAMP t0 "%s")
  execute_process(COMMAND "${WINRUN}" --detach --log "${log}" --rc "${rc_file}" --timeout 60 --
                          "${CMAKE_COMMAND}" -E sleep 15
                  WORKING_DIRECTORY "${WORK}" TIMEOUT 90 RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(TIMESTAMP t1 "%s")
  math(EXPR seconds "${t1} - ${t0}")
  file(WRITE "${WORK}/detach.log" "exit ${rc} after ${seconds} s\n--- stdout\n${out}\n--- stderr\n${err}\n")
  message("detach: exit ${rc} after ${seconds} s")
  if(NOT rc EQUAL 0)
    problem("--detach: exit ${rc}, not 0")
  endif()
  if(NOT out MATCHES "^[0-9]+\r?\n$")
    problem("--detach: no process id on stdout")
  endif()
  if(seconds GREATER 5)
    problem("--detach returned after ${seconds} s, not at once: the caller's pipe was handed to the copy")
  endif()
  set(waited 0)
  while(NOT EXISTS "${rc_file}" AND waited LESS 80)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
    math(EXPR waited "${waited} + 1")
  endwhile()
  math(EXPR total "${seconds} + ${waited}")
  message("detach: the rc file after ${total} s")
  if(NOT EXISTS "${rc_file}")
    problem("no rc file ${total} s after the start")
  else()
    file(READ "${rc_file}" copy_rc)
    string(STRIP "${copy_rc}" copy_rc)
    if(NOT copy_rc STREQUAL "0")
      problem("the rc file says ${copy_rc}, not 0")
    endif()
    if(total LESS 14)
      problem("the rc file after ${total} s: the program (15 s) did not run to its end")
    endif()
    file(READ "${log}" copy_log)
    if(NOT copy_log MATCHES "the program's exit status 0; winrun exits with 0")
      problem("the copy's log has no summary line with 0")
    endif()
  endif()

elseif(CASE STREQUAL "exitcode")
  run(nothing TIMEOUT 60 COMMAND "${EMULATOR}" ${keys})
  no_window(nothing)
  if(NOT nothing_rc EQUAL 1)
    problem("headless with nothing to run: exit ${nothing_rc}, not 1")
  endif()
  if(NOT nothing_out MATCHES "nulldc-exit: reason=error")
    problem("headless with nothing to run: no error line")
  endif()

else()
  message(FATAL_ERROR "windows.cmake: no case ${CASE}")
endif()

if(problems)
  string(REPLACE ";" "\n  " problems "${problems}")
  message(FATAL_ERROR "${CASE}:\n  ${problems}\n(the runs: ${WORK}/*.log)")
endif()
message("${CASE}: passed")
